{
  "name": "@studiocar/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json --outDir dist",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@studiocar/contracts": "workspace:*",
    "@studiocar/processing": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@studiocar/config": "workspace:*",
    "@types/pg": "catalog:",
    "prisma": "catalog:"
  }
}
