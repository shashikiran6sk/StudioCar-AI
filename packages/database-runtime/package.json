{
  "name": "@studiocar/database-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --outDir dist",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@studiocar/contracts": "workspace:*",
    "@studiocar/email": "workspace:*",
    "@studiocar/processing": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@studiocar/config": "workspace:*",
    "@types/pg": "catalog:"
  }
}
