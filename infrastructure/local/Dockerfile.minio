# MinIO's public container repositories became access restricted after its
# community repository was archived. Build the local emulator from the final
# security-patched community server release and its matching-era client so a
# fresh checkout does not depend on registry access to minio/minio.
FROM golang:1.24-alpine AS builder

ARG MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
ARG MINIO_CLIENT_VERSION=RELEASE.2025-08-13T08-35-41Z

RUN apk add --no-cache ca-certificates git
RUN CGO_ENABLED=0 go install "github.com/minio/minio@${MINIO_VERSION}"
RUN CGO_ENABLED=0 go install "github.com/minio/mc@${MINIO_CLIENT_VERSION}"

FROM alpine:3.22

RUN apk add --no-cache ca-certificates
COPY --from=builder /go/bin/minio /usr/local/bin/minio
COPY --from=builder /go/bin/mc /usr/local/bin/mc

VOLUME ["/data"]
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
