## StudioCar AI — Production configuration contract. Reference only.
##
## Do NOT copy this into a file. Production values come from the deployment
## platform: Vercel environment variables for the application, AWS Secrets
## Manager or SSM Parameter Store resolved into each Lambda's configuration,
## and a workload identity (IAM role) instead of AWS keys. Each runtime
## receives only the variables docs/security.md assigns to it; never give one
## process this whole list.
##
## Production refuses every Local and Development adapter: fake sign-in,
## MinIO, ElasticMQ, localhost endpoints, the local queue consumer,
## non-production buckets and queues, and every committed local value.
## Nothing missing here is ever filled in by a default.
##
## See docs/environments.md.

APP_ENV=production

## Application (Next.js) and image worker.
DATABASE_URL=

## Application only. At least 32 random characters.
SESSION_SECRET=

## Application only. Google OAuth; the redirect URI must be https.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

## Application only. MSG91 Widget OTP, with the production origin
## allow-listed on the widget. MSG91_AUTH_KEY never reaches a browser.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
MSG91_AUTH_KEY=

## Application and image worker. The bucket must carry a prod or production
## name segment (for example studiocar-prod-images). No endpoint and no keys:
## the workload identity supplies credentials.
AWS_REGION=
S3_BUCKET=

## Application (publisher) and image worker (consumer, through its event
## source). An AWS SQS https queue URL only.
SQS_IMAGE_QUEUE_URL=

## Image worker only.
REMOVEBG_API_KEY=

## Application and its trusted schedulers only. Three independently generated
## secrets of at least 32 characters.
PROCESSING_DISPATCH_TOKEN=
LIFECYCLE_CLEANUP_TOKEN=
STORAGE_CLEANUP_TOKEN=

## Optional, application only. First-administrator bootstrap on a database
## that has never had an administrator.
BOOTSTRAP_ADMIN_EMAIL=
# Razorpay Live Mode
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
