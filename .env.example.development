## StudioCar AI — Development environment.
##
##   cp .env.example.development .env.local
##
## Development exercises the real external boundaries — Google OAuth, MSG91
## phone OTP, AWS S3, AWS SQS, remove.bg, and its own database — while only the
## image worker and the dispatcher run locally through `pnpm infra:up`. Those
## local parts come from repository defaults and need no settings here.
##
## Every value below is required unless marked optional. A missing one is a
## configuration error: Development never falls back to a fake provider.
##
## See docs/environments.md.

APP_ENV=development

## The Development database. Never the production database. For Supabase use
## the direct host (db.<ref>.supabase.co): the session pooler admits only a few
## clients, fewer than `pnpm dev` holds open.
DATABASE_URL=

## Optional. The same database at an address the image worker container can
## reach. Docker Desktop has no IPv6 route, so set this when DATABASE_URL is
## IPv6-only, as Supabase's direct host is; for Supabase use the session pooler,
## postgres.<ref>@aws-0-<region>.pooler.supabase.com:5432. Empty means the
## worker uses DATABASE_URL. Run `pnpm infra:up` after changing it.
WORKER_DATABASE_URL=

## At least 32 random characters, e.g. `openssl rand -base64 48`. Development
## refuses the committed Local value.
SESSION_SECRET=

## Google OAuth. Register this exact redirect URI on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

## MSG91 Widget OTP. The widget id and token are browser-safe and served from
## /api/auth/phone/widget; MSG91_AUTH_KEY is server-only. Allow-list the
## Development origin (http://localhost:3000) on the MSG91 widget.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
MSG91_AUTH_KEY=

## The dedicated AWS S3 Development bucket. Never the production bucket; a
## bucket named with a prod or production segment is refused. Its CORS rule
## must allow the Development origin.
AWS_REGION=ap-south-1
S3_BUCKET=

## Optional. Leave both empty to use the AWS default credential chain (an AWS
## CLI profile, SSO, or the AWS_* environment variables). Set both or neither.
## Workers run in containers, where ~/.aws is not visible: give them this pair
## or AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY. Simplest: one IAM key with
## S3 and SQS access, added to this file under those two AWS_* names, with the
## S3_* and SQS_* pairs left empty; `pnpm dev` and the worker both read it.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

## The dedicated AWS SQS Development processing queue, in AWS_REGION. Never the
## production queue; a queue named with a prod or production segment is
## refused. The application publishes to it and the image worker consumes it.
SQS_IMAGE_QUEUE_URL=

## Optional. The same rules as the S3 pair above, for the queue: set both or
## neither, and give the worker container this pair or the AWS_* variables.
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=

## remove.bg performs the background removal.
REMOVEBG_API_KEY=

## Optional. The verified Google address that becomes the first administrator
## on a database that has never had one. It grants nothing afterwards.
BOOTSTRAP_ADMIN_EMAIL=
