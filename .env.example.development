## StudioCar AI — Development environment.
##
##   cp .env.example.development .env.local
##
## Development exercises the real external boundaries — Google OAuth, MSG91
## phone OTP, AWS S3, remove.bg, and its own database — while the processing
## queue (ElasticMQ), the image worker, and the dispatcher run locally through
## `pnpm infra:up`. Those local parts come from repository
## defaults and need no settings here.
##
## Every value below is required unless marked optional. A missing one is a
## configuration error: Development never falls back to a fake provider.
##
## See docs/environments.md.

APP_ENV=development

## The Development database. Never the production database.
DATABASE_URL=

## At least 32 random characters, e.g. `openssl rand -base64 48`. Development
## refuses the committed Local value.
SESSION_SECRET=

## Google OAuth. Register this exact redirect URI on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

## MSG91 Widget OTP. The widget id and token are browser-safe and served from
## /api/auth/phone/widget; MSG91_AUTH_KEY is server-only. Allow-list the
## Development origin (http://localhost:3000) on the MSG91 widget.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
MSG91_AUTH_KEY=

## The dedicated AWS S3 Development bucket. Never the production bucket; a
## bucket named with a prod or production segment is refused. Its CORS rule
## must allow the Development origin.
AWS_REGION=ap-south-1
S3_BUCKET=

## Optional. Leave both empty to use the AWS default credential chain (an AWS
## CLI profile, SSO, or the AWS_* environment variables). Set both or neither.
## Workers run in containers, where ~/.aws is not visible: give them this pair
## or export AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY before `pnpm infra:up`.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

## remove.bg performs the background removal.
REMOVEBG_API_KEY=

## Optional. The verified Google address that becomes the first administrator
## on a database that has never had one. It grants nothing afterwards.
BOOTSTRAP_ADMIN_EMAIL=
