{
  "name": "@studiocar/image-processing-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "sharp": "catalog:"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle.mjs src/handler.ts dist/handler.mjs",
    "build:local": "node scripts/bundle.mjs src/local.ts dist/local.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "evidence:processing": "node scripts/processing-evidence.mjs",
    "package:lambda": "node scripts/package-lambda.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sqs": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@sentry/node": "catalog:",
    "@studiocar/config": "workspace:*",
    "@studiocar/contracts": "workspace:*",
    "@studiocar/database-runtime": "workspace:*",
    "@studiocar/local-queue": "workspace:*",
    "@studiocar/observability": "workspace:*",
    "@studiocar/processing": "workspace:*",
    "esbuild": "catalog:",
    "pg": "catalog:",
    "vitest": "5.0.1"
  }
}
