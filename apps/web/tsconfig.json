{
  "extends": "../../packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "incremental": true,
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "next/*": [
        "./node_modules/next/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../tests/unit/app/**/*.ts",
    "../../tests/unit/app/**/*.tsx",
    "../../tests/unit/features/**/*.ts",
    "../../tests/unit/features/**/*.tsx",
    "../../tests/unit/server/**/*.ts",
    "../../tests/unit/server/**/*.tsx",
    "prisma.config.ts",
    "../../tests/integration/server/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
