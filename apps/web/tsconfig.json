{
  "extends": "../../packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "incremental": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../tests/unit/app/**/*.ts",
    "../../tests/unit/app/**/*.tsx",
    "../../tests/unit/server/**/*.ts",
    "../../tests/unit/server/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
