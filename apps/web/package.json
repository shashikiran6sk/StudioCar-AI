{
  "name": "@studiocar/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "billing:razorpay:setup": "esbuild prisma/razorpay-setup.ts --bundle --platform=node --target=node24 --format=esm --external:@prisma/adapter-pg --external:@prisma/client --external:pg --outfile=.razorpay-setup.mjs && node --env-file-if-exists=../../.env.local .razorpay-setup.mjs",
    "billing:business:setup": "esbuild prisma/billing-business-setup.ts --bundle --platform=node --target=node24 --format=esm --external:@prisma/adapter-pg --external:@prisma/client --external:pg --outfile=.billing-business-setup.mjs && node --env-file-if-exists=../../.env.local .billing-business-setup.mjs",
    "build": "next build",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "esbuild prisma/seed.ts --bundle --platform=node --target=node24 --format=esm --external:@prisma/adapter-pg --external:@prisma/client --external:pg --outfile=.prisma-seed.mjs && node --env-file-if-exists=../../.env.local .prisma-seed.mjs",
    "db:validate": "prisma validate",
    "dev": "next dev",
    "e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sqs": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@fontsource-variable/manrope": "5.3.0",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@studiocar/config": "workspace:*",
    "@studiocar/contracts": "workspace:*",
    "@studiocar/database-runtime": "workspace:*",
    "@studiocar/observability": "workspace:*",
    "@studiocar/processing": "workspace:*",
    "@studiocar/ui": "workspace:*",
    "fflate": "0.8.3",
    "next": "16.3.5",
    "openid-client": "catalog:",
    "pg": "catalog:",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "catalog:",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "esbuild": "catalog:",
    "prisma": "catalog:"
  }
}
