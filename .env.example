## Local development union only. Production runtimes receive only the variables
## assigned to them in docs/security.md; never copy this file wholesale.

NODE_ENV=development
DATABASE_URL=postgresql://studiocar:studiocar@localhost:5432/studiocar
SESSION_SECRET=replace-with-at-least-32-random-characters

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
OAUTH_CHALLENGE_TTL_SECONDS=600

## Phone OTP uses the MSG91 Widget flow: the browser sends and collects the
## code, and the server verifies the resulting access token. No DLT template is
## involved. `fake` sends no message and accepts PHONE_OTP_DEV_CODE; it is
## refused in production.
PHONE_OTP_DRIVER=fake
PHONE_OTP_DEV_CODE=1234
## Browser-safe widget configuration, served from /api/auth/phone/widget.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
## Server-only. Never expose this to the browser.
MSG91_AUTH_KEY=
MSG91_TIMEOUT_MS=5000
PHONE_OTP_CHALLENGE_TTL_SECONDS=600
PHONE_OTP_RATE_LIMIT_WINDOW_SECONDS=600
PHONE_OTP_SEND_MAX_PER_PHONE=3
PHONE_OTP_SEND_MAX_PER_IP=10
PHONE_OTP_VERIFY_MAX_PER_CHALLENGE=5
PHONE_OTP_VERIFY_MAX_PER_IP=30

## Email delivery. `mailpit` delivers to a local inbox and is refused in
## production; `resend` is the production provider.
EMAIL_DRIVER=mailpit
MAILPIT_BASE_URL=http://localhost:8025
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
APPLICATION_BASE_URL=http://localhost:3000

AWS_REGION=ap-south-1
S3_BUCKET=
SQS_IMAGE_QUEUE_URL=
SQS_EMAIL_QUEUE_URL=

## Object storage and queue connection.
## Leave the endpoint, path-style flag and key pairs empty in deployments that
## attach a workload identity; the AWS default credential chain is then used.
## Each key pair must be set together or not at all.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SQS_ENDPOINT=
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=
PROCESSING_DISPATCH_TOKEN=replace-with-at-least-32-random-characters
EMAIL_DISPATCH_TOKEN=replace-with-a-different-32-character-random-secret
LIFECYCLE_CLEANUP_TOKEN=replace-with-an-independent-32-character-random-secret
STORAGE_CLEANUP_TOKEN=replace-with-another-independent-32-character-secret
LIFECYCLE_CLEANUP_BATCH_SIZE=100
SESSION_RETENTION_DAYS=30
AUTH_CHALLENGE_RETENTION_DAYS=7
COMMAND_RATE_LIMIT_RETENTION_HOURS=24
STORAGE_CLEANUP_BATCH_SIZE=10
ABANDONED_UPLOAD_RETENTION_HOURS=24
STORAGE_DELETION_CLAIM_TTL_MS=120000
STORAGE_DELETION_MAX_ATTEMPTS=8
STORAGE_DELETION_RETRY_BASE_MS=30000
STORAGE_DELETION_RETRY_MAX_MS=3600000
UPLOAD_PRESIGN_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_PRESIGN_MAX_PER_WINDOW=120
PROCESSING_BATCH_RATE_LIMIT_WINDOW_SECONDS=60
PROCESSING_BATCH_MAX_PER_WINDOW=20
PROCESSING_OUTBOX_BATCH_SIZE=20
PROCESSING_OUTBOX_CLAIM_TTL_MS=30000
PROCESSING_OUTBOX_RETRY_BASE_MS=1000
PROCESSING_OUTBOX_RETRY_MAX_MS=60000
EMAIL_OUTBOX_BATCH_SIZE=20
EMAIL_OUTBOX_CLAIM_TTL_MS=30000
EMAIL_OUTBOX_RETRY_BASE_MS=1000
EMAIL_OUTBOX_RETRY_MAX_MS=60000
EMAIL_DELIVERY_CLAIM_TTL_MS=45000
IMAGE_WORKER_CLAIM_TTL_MS=120000
PROCESSING_RETRY_BASE_MS=5000
PROCESSING_RETRY_MAX_MS=300000
REMOVEBG_TIMEOUT_MS=60000
MAX_PROVIDER_INPUT_BYTES=23068672
MAX_PROVIDER_OUTPUT_BYTES=104857600
MAX_WORKER_IMAGE_PIXELS=50000000
PREVIEW_MAX_WIDTH=720

BACKGROUND_REMOVAL_PROVIDER=removebg
REMOVEBG_API_KEY=
FAL_KEY=
SELF_HOSTED_BIREFNET_ENDPOINT=

MAX_UPLOAD_BYTES=26214400
PRESIGNED_URL_TTL_SECONDS=300
MAX_IMAGE_DIMENSION=16384
MAX_IMAGE_PIXELS=100000000
NEXT_PUBLIC_APP_URL=http://localhost:3000
